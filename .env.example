# Django
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Inclua esquema (http/https) nas origens confiáveis de CSRF
CSRF_TRUSTED_ORIGINS=host

# Banco de Dados
# Quando DEBUG=true, utiliza SQLite por padrão (db.sqlite3 na raiz).
# Para forçar SQLite ou Postgres independentemente do modo DEBUG:
# USE_SQLITE=true / USE_SQLITE=false ou DB_ENGINE=sqlite / DB_ENGINE=postgres
USE_SQLITE=true

# Postgres (serviço docker-compose ou produção)
POSTGRES_DB=cars
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
